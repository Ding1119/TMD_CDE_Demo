# Copy to .env (or export in your shell). Everything is optional.

# Database (default: SQLite file in ./data). PostgreSQL example:
# TMD_CDE_DB_URL=postgresql+psycopg://user:pass@host:5432/tmd_cde

# LLM agents (Claude). Leave the key empty to use rule-based agents only.
ANTHROPIC_API_KEY=
TMD_CDE_LLM_PROVIDER=auto          # auto | none
TMD_CDE_LLM_MODEL=claude-sonnet-5-5

# Online sources & terminology APIs (PubMed, NIH CDE Repository, NLM Clinical Tables, EBI OLS, UMLS)
TMD_CDE_ONLINE=0
NCBI_EMAIL=
NCBI_API_KEY=
UMLS_API_KEY=                      # free account at https://uts.nlm.nih.gov (needed for SNOMED CT lookups)

# Switch to 1 once a TMD EHR extract / concept set is available (raises EHR-dictionary priority)
TMD_CDE_EHR_AVAILABLE=0

# Delphi consensus rule
TMD_CDE_DELPHI_THRESHOLD=0.70
TMD_CDE_DELPHI_MIN_RATERS=3
